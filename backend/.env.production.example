# ─── BRICS backend — PRODUCTION ───────────────────────────────────────────────
#
# Copy to `backend/.env.production` and fill it in. That file is git-ignored and
# must stay that way: it holds the keys to the company's books.
#
# On Render or Vercel these are **set in the host's dashboard**, not uploaded as
# a file. Keep the file anyway — it is the written record of what production
# needs, and what is still a placeholder.
#
# Anything reading `TODO:` below is not real yet.

# ─── Which environment this is ────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
# PORT is set by the host. Do not define it here.

# ─── Database ─────────────────────────────────────────────────────────────────
# Use the POOLED connection string for the running app, and the DIRECT one only
# to run migrations before a release.
#
# The production database must be its own project, not another database beside
# development: separate credentials, separate quota, and a mistake in dev that
# fills the disk cannot take production down with it.
#
# Region matters more than it looks. From India to a US region a query costs
# about 275 ms — measured. Singapore or Mumbai turns that into tens of
# milliseconds, and the difference is visible on every screen.
DATABASE_URL=TODO: postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/production?sslmode=require
DATABASE_SSL=true

# Used by hand, before a deploy: `DATABASE_URL=… pnpm --filter @brics/backend migration:run`
# DATABASE_DIRECT_URL=TODO: postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/production?sslmode=require

# Serverless only (Vercel functions). Omit on a long-lived server such as Render.
# DB_POOL_MAX=1

# ─── Web origins allowed to call this API ─────────────────────────────────────
# The real web origin, exactly. Never `*` — that hands every site on the
# internet the ability to call this API with a signed-in user's browser.
CORS_ORIGINS=TODO: https://brics.yourdomain.com

# ─── Tokens ───────────────────────────────────────────────────────────────────
# Generate fresh, never reuse a development value, and keep the two different:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=TODO: generate-a-fresh-48-byte-secret
JWT_REFRESH_SECRET=TODO: generate-a-different-fresh-48-byte-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── First owner (first deploy only) ──────────────────────────────────────────
# `pnpm seed` creates the chart of accounts, the roles and one Owner, and
# refuses to run once any user exists.
#
# DELETE THESE FIVE LINES FROM THE HOST AFTER THE FIRST DEPLOY. A password
# sitting in a dashboard is a password that leaks, and they are of no further
# use once the owner has signed in and changed it.
SEED_COMPANY_NAME=TODO: the company name as it should appear on invoices
SEED_COMPANY_STATE_CODE=TODO: 09 for Uttar Pradesh
SEED_OWNER_NAME=TODO: the owner's name
SEED_OWNER_MOBILE=TODO: the owner's mobile
SEED_OWNER_EMAIL=TODO: the owner's email
SEED_OWNER_PASSWORD=TODO: a strong password, changed at first login

# ─── Not needed in CP1 ────────────────────────────────────────────────────────
# No object storage: nothing is uploaded. Invoice and challan PDFs are generated
#   per request and streamed, never stored.
# No email provider: BRICS sends no email.
# No payment gateway: BRICS records payments, it does not take them.
#
# If NTF-01 (SMS / WhatsApp) is confirmed as in scope, it adds exactly one
# account and one key:
# MSG91_AUTH_KEY=
#
# If the API runs on serverless (Vercel), rate limiting needs a shared counter
# or it is decoration — each instance otherwise counts in its own memory:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
