# BRICS backend — PRODUCTION
# Copy to backend/.env.production (git-ignored). On Render/Vercel set these in
# the dashboard. `TODO:` = not a real value yet.

NODE_ENV=production
LOG_LEVEL=info

# Pooled URL. Own project, region near India (ap-southeast-1), db `production`.
DATABASE_URL=TODO: postgresql://USER:PASSWORD@HOST-pooler.ap-southeast-1.aws.neon.tech/production?sslmode=require
DATABASE_SSL=true

# Direct URL — used by hand to run migrations before a release.
DATABASE_DIRECT_URL=TODO: postgresql://USER:PASSWORD@HOST.ap-southeast-1.aws.neon.tech/production?sslmode=require

# Serverless only (Vercel). Omit on Render.
# DB_POOL_MAX=1

# Exact web origin. Never `*`.
CORS_ORIGINS=TODO: https://brics.yourdomain.com

# Two different secrets: openssl rand -base64 48
JWT_ACCESS_SECRET=TODO
JWT_REFRESH_SECRET=TODO
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# First deploy only — delete from the host afterwards.
SEED_COMPANY_NAME=TODO
SEED_COMPANY_STATE_CODE=TODO
SEED_OWNER_NAME=TODO
SEED_OWNER_MOBILE=TODO
SEED_OWNER_EMAIL=TODO
SEED_OWNER_PASSWORD=TODO

# Not needed in CP1: object storage, email, payment gateway.
# MSG91_AUTH_KEY=            # only if NTF-01 is confirmed in scope
# UPSTASH_REDIS_REST_URL=    # only on serverless — else rate limiting is per-instance
# UPSTASH_REDIS_REST_TOKEN=
