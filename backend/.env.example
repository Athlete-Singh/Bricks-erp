# ─── BRICS backend environment ────────────────────────────────────────────────
# Copy to `backend/.env` for local development.
# For a deployed environment, copy `backend/.env.production.example` instead and
# set the values in the host's own dashboard (Render / Vercel → Environment).
# Never commit a filled-in file: `.env`, `.env.production` and friends are ignored.

# ─── Which environment this is ────────────────────────────────────────────────
NODE_ENV=development            # development | test | production
PORT=4000                       # API port → http://localhost:4000/api/v1
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace

# ─── Database: LOCAL DEVELOPMENT ──────────────────────────────────────────────
# Two ways to run day-to-day. Pick one and leave the other commented.
#
# (a) Docker on this machine — `docker compose -f infra/docker-compose.yml up -d`.
#     A query costs a fraction of a millisecond, and it works on a train.
DATABASE_URL=postgres://brics:brics@localhost:5432/brics
DATABASE_SSL=false
#
# (b) A hosted development database (Neon, Supabase, …). Convenient, shared
#     between machines, and **about 275 ms per query** from India to a US
#     region — measured, not guessed. A screen that makes eight queries spends
#     two seconds on the network alone. Prefer a region near you.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/development?sslmode=require
# DATABASE_SSL=true

# ─── Database: TESTS ──────────────────────────────────────────────────────────
# Keep this one local even if development uses a hosted database. The e2e suite
# makes tens of thousands of round trips; on a remote database the same run goes
# from about four minutes to several hours, and a suite nobody can afford to run
# is a suite that stops being run.
TEST_DATABASE_URL=postgres://brics:brics@localhost:5432/brics_test

# ─── Connection pool ──────────────────────────────────────────────────────────
# Leave unset on a long-lived server. Set to 1 on serverless hosting (Vercel
# functions), where many short-lived instances would otherwise exhaust the
# database while the app still looks idle.
# DB_POOL_MAX=1

# ─── Web origins allowed to call this API ─────────────────────────────────────
CORS_ORIGINS=http://localhost:3000   # comma-separated; never `*`

# ─── Tokens ───────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── First-run seed (`pnpm seed`) ─────────────────────────────────────────────
# The Owner is created only when SEED_OWNER_MOBILE and SEED_OWNER_PASSWORD are
# both set AND no user exists yet. Local values — never reuse in production.
SEED_COMPANY_NAME=My Brick Kiln
SEED_COMPANY_STATE_CODE=09
SEED_OWNER_NAME=Owner
SEED_OWNER_MOBILE=9000000000
SEED_OWNER_EMAIL=owner@example.test
SEED_OWNER_PASSWORD=change-me-before-first-run
