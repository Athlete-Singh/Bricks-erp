# ─── BRICS backend environment ────────────────────────────────────────────────
# Copy to `backend/.env` for local dev. Never commit real secrets.
# In production set these in Render → Environment.

# Backend
NODE_ENV=development            # development | test | production
PORT=4000                       # API port → http://localhost:4000/api/v1
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace
DATABASE_URL=postgres://brics:brics@localhost:5432/brics   # Supabase pooled URL in prod
DATABASE_SSL=false              # true on Supabase
# DB_POOL_MAX=1                 # set to 1 on serverless hosting (Vercel); omit on a long-lived server
CORS_ORIGINS=http://localhost:3000   # comma-separated web origins
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars   # used from P1
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars # used from P1
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Test DB (backend e2e)
TEST_DATABASE_URL=postgres://brics:brics@localhost:5432/brics_test

# First-run seed (`pnpm seed`). Optional: the Owner is only created when
# SEED_OWNER_MOBILE and SEED_OWNER_PASSWORD are both set AND no user exists yet.
# Local development values — never reuse these in staging or production.
SEED_COMPANY_NAME=My Brick Kiln
SEED_COMPANY_STATE_CODE=09
SEED_OWNER_NAME=Owner
SEED_OWNER_MOBILE=9000000000
SEED_OWNER_EMAIL=owner@example.test
SEED_OWNER_PASSWORD=change-me-before-first-run
