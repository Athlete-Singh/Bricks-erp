# ─── BRICS backend environment ────────────────────────────────────────────────
# Copy to `backend/.env` for local dev. Never commit real secrets.
# In production set these in Render → Environment.

# Backend
NODE_ENV=development            # development | test | production
PORT=4000                       # API port → http://localhost:4000/api/v1
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace
DATABASE_URL=postgres://brics:brics@localhost:5432/brics   # Supabase pooled URL in prod
DATABASE_SSL=false              # true on Supabase
CORS_ORIGINS=http://localhost:3000   # comma-separated web origins
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars   # used from P1
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars # used from P1
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Test DB (backend e2e)
TEST_DATABASE_URL=postgres://brics:brics@localhost:5432/brics_test
