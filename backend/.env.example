# BRICS backend — local development
# Copy to backend/.env. For a deployed environment see .env.production.example.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Hosted dev database (shared between machines, ~275 ms per query from India).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/development?sslmode=require
DATABASE_SSL=true
# Offline / faster alternative — swap with the two lines above.
# DATABASE_URL=postgres://brics:brics@localhost:5432/brics
# DATABASE_SSL=false

# Tests stay local: the e2e suite makes tens of thousands of round trips.
# docker compose -f infra/docker-compose.yml up -d
TEST_DATABASE_URL=postgres://brics:brics@localhost:5432/brics_test

# Serverless only. Omit on a long-lived server.
# DB_POOL_MAX=1

CORS_ORIGINS=http://localhost:3000

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# `pnpm seed` — creates the Owner once, only if no user exists yet.
SEED_COMPANY_NAME=My Brick Kiln
SEED_COMPANY_STATE_CODE=09
SEED_OWNER_NAME=Owner
SEED_OWNER_MOBILE=9000000000
SEED_OWNER_EMAIL=owner@example.test
SEED_OWNER_PASSWORD=change-me-before-first-run

# NTF-01 — SMS / WhatsApp alerts (docs/modules/notifications.md). `log` sends nothing.
NOTIFY_PROVIDER=log
NOTIFY_CHANNEL=sms
# MSG91 (DLT template ids from the client's DLT registration)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_DISPATCH_SENT=
MSG91_TEMPLATE_PAYMENT_RECEIVED=
MSG91_TEMPLATE_ADVANCE_ALERT=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
