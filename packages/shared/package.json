{
  "name": "@brics/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared types, enums, constants, Zod schemas and formatters (backend + web)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
