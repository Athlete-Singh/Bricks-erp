# deps & builds
node_modules/
dist/
build/
.next/
out/
coverage/
.turbo/
*.tsbuildinfo
# env & secrets
# Every real env file is ignored; only the templates are tracked, and they are
# tracked on purpose — they are the written record of what each environment
# needs. `.env.production` holds the keys to the company's books and must never
# be committed; `.env.production.example` is the same file with TODOs.
.env
.env.*
!.env.example
!.env.*.example
# Private keys and certificates — never belong in a repo, even by accident.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
*.crt
# Service-account and cloud credential files
**/credentials.json
**/service-account*.json
.aws/
.gcloud/
# local databases and dumps — a dump carries real data, not just schema
*.sqlite
*.sqlite3
*.db
*.sql.gz
*.dump
# logs / OS / editors
*.log
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
# flutter
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.fvm/flutter_sdk
mobile/android/.gradle/
mobile/android/local.properties
mobile/ios/Pods/
mobile/ios/Flutter/Generated.xcconfig
mobile/*.iml
mobile/android/key.properties
mobile/android/app/*.jks
mobile/android/app/*.keystore

# Personal command cheat sheet, not shared
RUN.md
cred.txt

# Playwright (P13.1) — traces and reports are run artefacts, never committed
web/test-results/
web/playwright-report/
web/blob-report/

# ADM-09 local backups hold the books — never committed
backups/
