# ─── BRICS web — PRODUCTION ───────────────────────────────────────────────────
#
# Copy to `web/.env.production` and fill it in. That file is git-ignored.
# On Vercel these are set in Project → Settings → Environment Variables; keep
# the file as the written record of what production needs.
#
# NEXT_PUBLIC_* values are compiled into the browser bundle. Anyone who opens
# the site can read them, so nothing secret ever goes in this file — no
# database URL, no API key, no token.

# The deployed API, including the /api/v1 prefix.
NEXT_PUBLIC_API_URL=TODO: https://brics-api.onrender.com/api/v1
