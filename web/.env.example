# ─── BRICS web environment ────────────────────────────────────────────────────
# Copy to `web/.env.local` for local development.
# For a deployed environment see `web/.env.production.example`.
#
# NEXT_PUBLIC_* values are compiled into the browser bundle: never put a secret
# here, not even briefly.

NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
